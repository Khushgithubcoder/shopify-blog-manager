# --- Shopify app (Partner/Dev Dashboard -> your app -> Client credentials) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_content,write_content
SHOPIFY_API_VERSION=2026-07

# Public HTTPS URL of THIS backend (no trailing slash). Shopify redirects here after install.
# Must match the "Allowed redirection URL" in the app: <APP_URL>/shopify/callback
APP_URL=https://your-tunnel-or-domain.example.com

# --- Server ---
SESSION_SECRET=change-me-to-a-long-random-string
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
COOKIE_SECURE=true        # true whenever you use https (tunnel/production); false only for plain http
FRONTEND_URL=             # empty = frontend served by this backend (recommended)
CORS_ORIGINS=             # only if the frontend runs on another origin, e.g. http://localhost:5500

# --- PostgreSQL ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/shopify_blog
